# ============================================================
# AI 接口配置模板 —— 空白占位，请复制为 ai_provider.env 后填写
# 放置位置：数据仓库根目录（DATA_DIR 指向的目录）
# ⚠️ 填好后的 ai_provider.env 含密钥，必须 gitignore，不要提交/发给别人
# ============================================================
# 本协议只要求对方兼容 OpenAI 的 POST {AI_BASE_URL}/chat/completions
# 与 Bearer 鉴权，所以 DeepSeek / 本地模型 / 其他厂商都能接。

# [必填] 你的 API Key
# DeepSeek 形如 sk- 开头；其他服务按各自格式填
AI_API_KEY=

# [必填] 接口根地址（不要在末尾加 /chat/completions）
# 例：DeepSeek        https://api.deepseek.com
#     本地 Ollama     http://127.0.0.1:11434/v1
#     其他兼容服务    https://<your-provider>/v1
AI_BASE_URL=

# [必填] 模型名
# DeepSeek 可用：deepseek-flash（便宜、默认）/ deepseek-v4-pro（更强）
# 注意：旧别名 deepseek-chat 已被 API 拒绝，不要填
AI_MODEL=

# [可选] 采样温度 0~1，默认 0.7；越低越稳定
AI_TEMPERATURE=0.7

# ------------------------------------------------------------
# 兼容说明：旧键 DEEPSEEK_API_KEY / MODEL 仍会被读取，
# 但 AI_* 优先级更高。新部署统一用上面三项即可。
# 代码里的公开默认端点只是最后兜底，实际运行时以本文件为准。
# ------------------------------------------------------------
