# === 代码/数据分离：本文件是配置模板，真实配置放在数据仓库 ===
# 复制一份到 <数据仓库>/.env 并填写；代码仓库里不要放任何真实配置。
# 契约见 DATA_CONTRACT.md，配置完跑 `python -m copilot.main doctor` 体检。

# 数据仓库根目录（口径包 / examples.md / contacts / notes / logs 都在这里）
# 可用环境变量 DATA_DIR 覆盖；留空 = 不挂个人数据，AI 用内置通用示例兜底
DATA_DIR=

# === AI 接口：不在这个文件里填 ===
# Key / 接口地址 / 模型名全部放在数据仓库的 ai_provider.env，
# 空白模板 + 逐项字段说明见同目录 ai_provider.env.example
# （那里写清了 AI_API_KEY / AI_BASE_URL / AI_MODEL 各该填什么、怎么换厂商）
# 下面两个旧键仅为兼容旧安装保留，新部署一律用 AI_* 键，留空即可
DEEPSEEK_API_KEY=
MODEL=

# 微信数据目录（xwechat_files 根目录，含 wxid_xxx 子目录）；留空自动探测
WECHAT_DB_DIR=

# 检索语料目录（可选）：显式指定时优先；留空则读 <DATA_DIR>/notes
# 两者都空 = 关闭关键词检索兜底，只用口径包 + 联系人档案
JOB_DOCS_DIR=

# 只监听的联系人（昵称/备注/wxid，逗号或顿号分隔）；留空 = 全局监听（自动跳过群聊）
# 注意：名字里不能带逗号；名字带 | 没关系
WATCH_CHATS=

# 自动回复：0=人工确认（默认，推荐），1=自动回复；也可用 --auto 临时开启
AUTO_SEND=0

# 检测节奏（秒）：对话中 TICK_ACTIVE 秒查一次；连续 TICK_WINDOW 秒
# 没有新消息就降到 TICK_IDLE 省资源；静默期间来消息会立刻唤醒提速。
# 启动先按快档，避免重启后第一条消息等满 TICK_IDLE。
TICK_IDLE=60
TICK_ACTIVE=10
TICK_WINDOW=600

# 回复队列（秒）：每条消息都入队不丢，REPLY_WINDOW 内连发的多条攒成一批，
# 由 AI 合并成一条回复统一答；两次实际发送间隔 >= REPLY_WINDOW。
# 单条消息静默 REPLY_QUIET_FAST 秒没人接着问就直接回，不用干等 60s；
# 设为 0 则严格等满窗口。
REPLY_WINDOW=60
REPLY_QUIET_FAST=8
# 每次运行每个联系人最多自动回几批，超了转人工并打印建议
AUTO_MAX_PER_CHAT=20
