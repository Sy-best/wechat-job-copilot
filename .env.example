# DeepSeek API Key（必填；.env 已在 .gitignore 中，切勿提交）
DEEPSEEK_API_KEY=

# 模型: deepseek-flash（默认路由）或 deepseek-v4-pro
MODEL=deepseek-flash

# 微信数据目录（xwechat_files 根目录，含 wxid_xxx 子目录）；留空自动探测
WECHAT_DB_DIR=

# 找工作笔记目录（可选）：用于关键词检索兜底，留空 = 关闭检索
# 第一次使用建议留空，配好口径包后按需开启
JOB_DOCS_DIR=

# 只监听的联系人（昵称/备注/wxid，逗号或顿号分隔）；留空 = 全局监听（自动跳过群聊）
# 注意：名字里不能带逗号；名字带 | 没关系
WATCH_CHATS=

# 自动回复：0=人工确认（默认，推荐），1=自动回复；也可用 --auto 临时开启
AUTO_SEND=0

# 检测节奏（秒）：对话中 TICK_ACTIVE 秒查一次；连续 TICK_WINDOW 秒
# 没有新消息就降到 TICK_IDLE 省资源；静默期间来消息会立刻唤醒提速。
# 启动先按快档，避免重启后第一条消息等满 TICK_IDLE。
TICK_IDLE=60
TICK_ACTIVE=10
TICK_WINDOW=600

# 回复队列（秒）：每条消息都入队不丢，REPLY_WINDOW 内连发的多条攒成一批，
# 由 AI 合并成一条回复统一答；两次实际发送间隔 >= REPLY_WINDOW。
# 单条消息静默 REPLY_QUIET_FAST 秒没人接着问就直接回，不用干等 60s；
# 设为 0 则严格等满窗口。
REPLY_WINDOW=60
REPLY_QUIET_FAST=8
# 每次运行每个联系人最多自动回几批，超了转人工并打印建议
AUTO_MAX_PER_CHAT=20
